{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "EVE_*",
        "SUPERMEMORY_*",
        "TELEGRAM_*",
        "BLOB_*",
        "VERCEL_*",
        "MYEVE_*",
        "SOFIE_*",
        "FACTORY_*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "EVE_*",
        "SUPERMEMORY_*",
        "TELEGRAM_*",
        "BLOB_*",
        "VERCEL_*",
        "COMPOSIO_*",
        "AI_GATEWAY_*"
      ]
    }
  }
}
