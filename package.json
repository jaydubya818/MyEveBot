{
  "name": "eveclaw",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "db:migrate": "npm run db:migrate --workspace=eve-agent",
    "db:migrations:check": "npm run db:migrations:check --workspace=eve-agent",
    "dev": "turbo run dev",
    "test": "node --import tsx --test apps/eve/test/*.test.mjs apps/eve/scripts/*.test.mjs",
    "typecheck": "turbo run typecheck --filter='!@mission-control/capability-control' && tsc --project packages/capability-control/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pg": "^8.20.0",
    "turbo": "^2.10.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "brace-expansion": "5.0.12",
    "raindrop-ai": {
      "langsmith": "0.6.0"
    },
    "ai": "^7.0.114",
    "undici@>=8.0.0 <8.10.2": "8.10.2"
  }
}
