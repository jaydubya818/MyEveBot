166568f73e3231c96e47fec3c8a535","protected-evidence:sha256:db5bde1545dd47df4b1782eb4c995a4064166568f73e3231c96e47fec3c8a535","protected-evidence:sha256:db5bde1545dd47df4b1782eb4c995a4064166568f73e3231c96e47fec3c8a535","protected-evidence:sha256:db5bde1545dd47df4b1782eb4c995a4064166568f73e3231c96e47fec3c8a535","protected-evidence:sha256:db5bde1545dd47df4b1782eb4c995a4064166568f73e3231c96e47fec3c8a535","protected-evidence:sha256:db5bde1545dd47df4b1782eb4c995a4064166568f73e3231c96e47fec3c8a535","changed-source:quantity.mjs"],"limitations":["Factory-produced candidate in MyEve custody and protected local verification only. GitHub publication, CI, review and owner acceptance have not been established.","Native model cost coverage is UNKNOWN. No zero-cost or complete-cost claim is made."]},"contentHash":"29c156fc0b729ce544e0d0853a59a7fb259a49c034b31f797853b50ea530aad1"},"candidates":[{"id":"9dc97e82-f3c3-485a-92b3-2df630aba0fe","sha":"71dcedfbf74776a85ca3c9ce24aa7627f20612ac","tree":"491baa865101947d484ec78ee44727e173d7fcf7","files":{"README.md":"# myeve-golden-work-qual\n\nDisposable, private sandbox for MyEve Golden Work qualification.\n\n- Approved for throwaway qualification branches and draft pull requests.\n- Contains no customer code, secrets, or production configuration.\n- CI: `.github/workflows/quantity-ci.yml` (check name `quantity-ci`) runs `npm test` on every pull request.\n\n## Task\n\nSee the open issue: implement `quantity.mjs` at the repository root.\n\n```\necho 2   | node quantity.mjs   # {\"quantity\":2}\necho 0   | node quantity.mjs   # {\"error\":\"invalid_quantity\"}\necho -3  | node quantity.mjs   # {\"error\":\"invalid_quantity\"}\necho 1.5 | node quantity.mjs   # {\"error\":\"invalid_quantity\"}\n```\n",".gitignore":"node_modules/\n","package.json":"{\n  \"name\": \"myeve-golden-work-qual\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"Disposable MyEve Golden Work qualification sandbox.\",\n  \"type\": \"module\",\n  \"engines\": { \"node\": \">=20\" },\n  \"scripts\": {\n    \"test\": \"node --test test/quantity.test.mjs\"\n  }\n}\n","quantity.mjs":"import { stdin } from 'node:process';\n\nfunction readStdin(stream) {\n  return new Promise((resolve, reject) => {\n    const chunks = [];\n    stream.on('data', (chunk) => chunks.push(chunk));\n    stream.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));\n    stream.on('error', reject);\n  });\n}\n\nconst raw = await readStdin(stdin);\nconst trimmed = raw.trim();\n\n// Fix: only accept strings of one or more digits (no sign, no decimal\n// point), so fractional input like \"1.5\" is rejected instead of truncated.\nconst isPositiveIntegerString = /^[0-9]+$/.test(trimmed);\nconst n = isPositiveIntegerString ? parseInt(trimmed, 10) : NaN;\n\nif (Number.isNaN(n) || n <= 0) {\n  console.log(JSON.stringify({ error: 'invalid_quantity' }));\n} else {\n  console.log(JSON.stringify({ quantity: n }));\n}\n","test/quantity.test.mjs":"import { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { spawnSync } from 'node:child_process';\nimport { existsSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\n\nconst script = fileURLToPath(new URL('../quantity.mjs', import.meta.url));\n\nfunction run(input) {\n  const r = spawnSync(process.execPath, [script], { input, encoding: 'utf8', timeout: 5000 });\n  assert.equal(r.error, undefined, `failed to run quantity.mjs: ${r.error}`);\n  const out = r.stdout.trim();\n  let parsed;\n  assert.doesNotThrow(() => { parsed = JSON.parse(out); }, `stdout is not JSON: ${JSON.stringify(out)}`);\n  return parsed;\n}\n\ntest('quantity.mjs exists', () => {\n  assert.ok(existsSync(script), 'quantity.mjs must exist at the repository root');\n});\n\nconst valid = [['2', 2], ['1', 1], ['42\\n', 42], ['  7  \\n', 7]];\nfor (const [input, expected] of valid) {\n  test(`positive integer ${JSON.stringify(input)} -> {\"quantity\":${expected}}`, () => {\n    assert.deepEqual(run(input), { quantity: expected });\n  });\n}\n\nconst invalid = ['0', '-1', '-5\\n', '1.5', '0.25', '2.7\\n'];\nfor (const input of invalid) {\n  test(`invalid ${JSON.stringify(input)} -> {\"error\":\"invalid_quantity\"}`, () => {\n    assert.deepEqual(run(input), { error: 'invalid_quantity' });\n  });\n}\n",".github/workflows/quantity-ci.yml":"name: quantity-ci\n\non:\n  pull_request:\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\njobs:\n  quantity-ci:\n    name: quantity-ci\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 20\n      - run: npm test\n"},"patch":"[{\"path\":\"quantity.mjs\",\"before\":null,\"after\":\"import { stdin } from 'node:process';\\n\\nfunction readStdin(stream) {\\n  return new Promise((resolve, reject) => {\\n    const chunks = [];\\n    stream.on('data', (chunk) => chunks.push(chunk));\\n    stream.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));\\n    stream.on('error', reject);\\n  });\\n}\\n\\nconst raw = await readStdin(stdin);\\nconst trimmed = raw.trim();\\n\\n// Fix: only accept strings of one or more digits (no sign, no decimal\\n// point), so fractional input like \\\"1.5\\\" is rejected instead of truncated.\\nconst isPositiveIntegerString = /^[0-9]+$/.test(trimmed);\\nconst n = isPositiveIntegerString ? parseInt(trimmed, 10) : NaN;\\n\\nif (Number.isNaN(n) || n <= 0) {\\n  console.log(JSON.stringify({ error: 'invalid_quantity' }));\\n} else {\\n  console.log(JSON.stringify({ quantity: n }));\\n}\\n\"}]","runId":"1f3f41e1-bb14-49d5-bb33-5d537be6d6a1","commit":{"date":"2026-09-29T00:31:23.934Z","name":"MyFactory","email":"provenance@invalid","message":"Factory raw commit retained verbatim"},"workId":"cf1526c7-41e5-44dc-81fb-e4ef92946f4b","baseSha":"f74c75249c7e848a61c61d1a88972688730e00c3","producer":"MYFACTORY","attemptId":"e2291b90-4db3-4a2f-bf0c-b9b1584d5b25","createdAt":"20