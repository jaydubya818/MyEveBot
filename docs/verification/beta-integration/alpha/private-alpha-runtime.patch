+import {describe,it,expect} from 'vitest';
+import {betaConfiguration} from './configuration.ts';
+const alpha={MYEVE_BETA_MODE:'private-alpha',MYEVE_OWNER_ID:'owner-one',MYEVE_ACCESS_PASSWORD:'test-only-password',MYEVE_SESSION_SECRET:'test-only-secret-at-least-thirty-two-characters',DATABASE_URL:'postgresql://fixture:fixture@db.example.invalid/alpha',MYEVE_ALPHA_REPOSITORY:'fixture/golden',MYEVE_ALPHA_MAX_WORK_USD:'1.35',MYEVE_ALPHA_MAX_WORK_SECONDS:'600'};
+describe('Private alpha database and policy boundary',()=>{
+ it('uses the canonical app DB only after explicit authenticated owner activation',()=>{expect(betaConfiguration(alpha).url).toBe(alpha.DATABASE_URL);expect(()=>betaConfiguration({...alpha,MYEVE_BETA_MODE:undefined})).toThrow();for(const key of ['MYEVE_OWNER_ID','MYEVE_SESSION_SECRET','MYEVE_ACCESS_PASSWORD','DATABASE_URL'])expect(()=>betaConfiguration({...alpha,[key]:''})).toThrow();});
+ it('retains finite bounded Work ceilings and requires reviewed repository configuration',()=>{for(const value of ['0','-1','Infinity','1.36',''])expect(()=>betaConfiguration({...alpha,MYEVE_ALPHA_MAX_WORK_USD:value})).toThrow();expect(()=>betaConfiguration({...alpha,MYEVE_ALPHA_MAX_WORK_SECONDS:'601'})).toThrow();expect(()=>betaConfiguration({...alpha,MYEVE_ALPHA_REPOSITORY:undefined})).toThrow();});
+ it('qualification never falls back to deployment data and remains forbidden in production',()=>{const local={...alpha,MYEVE_BETA_MODE:'qualification',MYEVE_BETA_DATABASE_URL:'postgresql://postgres@127.0.0.1:55489/myeve_beta_test'};expect(betaConfiguration(local).url).toBe(local.MYEVE_BETA_DATABASE_URL);expect(()=>betaConfiguration({...local,MYEVE_BETA_DATABASE_URL:alpha.DATABASE_URL})).toThrow();expect(()=>betaConfiguration({...local,MYEVE_BETA_DATABASE_URL:undefined})).toThrow();expect(()=>betaConfiguration({...local,VERCEL_ENV:'production'})).toThrow();});
+});
