# MyEve Builder (apps/builder) environment variable names.
# Copy to apps/builder/.env.local and fill in your own values. Never commit real values.
# On Vercel, VERCEL_* system variables are provided automatically.

# --- Builder app runtime ---------------------------------------------------
# Default agent display name baked into generated installations.
NEXT_PUBLIC_AGENT_NAME=
# Trusted Relay origin the Builder accepts.
BUILDER_RELAY_ORIGIN=

# --- Operator scripts (scripts/smoke-deploy.ts, scripts/debug-deploy.ts) ---
VERCEL_TOKEN=
DATABASE_URL=

# --- Managed installations (scripts/managed-eve.ts) ------------------------
MYEVE_CONTROL_VERCEL_TOKEN=
MYEVE_CONTROL_REGISTRY_PATH=
MYEVE_CONTROL_BUILDER_ORIGIN=
MYEVE_CONTROL_TEAM_ID=
MYEVE_CONTROL_TEAM_SLUG=

# --- Provided by Vercel at runtime (read by scripts/debug-deploy.ts) -------
# VERCEL_DEPLOYMENT_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# VERCEL_ENV=
# VERCEL_OIDC_TOKEN=
