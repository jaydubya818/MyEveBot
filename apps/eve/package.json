{
  "name": "eve-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "npm run skills:prepare && next build",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.ts",
    "db:migrations:check": "node scripts/migrate-database.ts --check",
    "dev": "next dev",
    "eval:skills": "eve eval skills/routing --strict --max-concurrency 2",
    "skills:catalog": "node scripts/generate-skill-catalog.mjs",
    "skills:prepare": "node scripts/normalize-imported-skills.mjs && node scripts/generate-skill-catalog.mjs",
    "seed:knowledge-preview": "node --env-file-if-exists=.env.local scripts/seed-knowledge-preview.ts",
    "start": "next start",
    "typecheck": "tsc && tsx scripts/check-capability-registry.ts"
  },
  "dependencies": {
    "@agent-browser/eve": "^0.32.3",
    "@base-ui/react": "^1.6.0",
    "@cloudflare/kumo": "^2.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.2.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/connect": "0.4.0",
    "ai": "^7.0.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.6.2",
    "eve": "^0.27.0",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.13.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "microsandbox": "^0.5.10",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ai": "^7.0.26"
  },
  "engines": {
    "node": "24.x"
  }
}
