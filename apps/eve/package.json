{
  "name": "eve-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "local:setup": "node --import tsx scripts/local-computer/setup.ts",
    "local:start": "node --import tsx scripts/local-computer/service.ts start",
    "computer:prewarm": "node --env-file-if-exists=.env.local --import tsx scripts/prewarm-computer.ts",
    "build": "npm run skills:prepare && next build && node scripts/check-cloud-client-credentials.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.ts",
    "db:migrations:check": "node scripts/migrate-database.ts --check",
    "dev": "next dev",
    "eval": "eve eval",
    "eval:ci": "eve eval --tag ci --strict --junit .eve/junit.xml",
    "eval:fast": "eve eval --tag fast",
    "eval:list": "eve eval --list",
    "eval:skills": "eve eval skills/routing --strict --max-concurrency 2",
    "eval:write": "eve eval --tag write",
    "skills:catalog": "node scripts/generate-skill-catalog.mjs",
    "skills:prepare": "node scripts/normalize-imported-skills.mjs && node scripts/generate-skill-catalog.mjs",
    "skills:validate": "node scripts/check-imported-skill-routing.mjs",
    "smoke:browser-production": "node scripts/smoke-browser-production.mjs",
    "smoke:core-production": "node scripts/smoke-core-production.mjs",
    "smoke:production": "npm run smoke:core-production && npm run smoke:browser-production",
    "seed:knowledge-preview": "node --env-file-if-exists=.env.local scripts/seed-knowledge-preview.ts",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc && tsx scripts/check-capability-registry.ts && npm run skills:validate && node --import tsx scripts/check-executor-governance.ts",
    "decision:evaluate": "node scripts/decision-evaluate.ts",
    "local:service": "node --import tsx scripts/local-computer/service.ts"
  },
  "dependencies": {
    "@agent-browser/eve": "^0.39.1",
    "@agent-browser/sandbox": "^0.39.1",
    "@ai-sdk/mcp": "2.0.78",
    "@base-ui/react": "^1.9.0",
    "@braintrust/otel": "^1.0.2",
    "@cloudflare/kumo": "^2.14.0",
    "@mission-control/capability-control": "*",
    "@neondatabase/serverless": "^1.2.0",
    "@novnc/novnc": "^1.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@shadcn/react": "^0.3.1",
    "@spectrum-ts/core": "^12.12.0",
    "@spectrum-ts/imessage": "^12.11.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/connect": "2.5.2",
    "@vercel/functions": "^3.10.1",
    "@vercel/oidc": "3.8.10",
    "@vercel/otel": "^2.1.3",
    "@vercel/queue": "0.8.0",
    "@vercel/sandbox": "^3.8.0",
    "ai": "^7.0.143",
    "braintrust": "^3.37.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "effect": "4.0.6",
    "eve": "^0.66.3",
    "heif2jpeg": "^0.1.6",
    "jszip": "^3.10.1",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "raindrop-ai": "0.8.0-otelv2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^6.0.3",
    "remark-breaks": "^4.0.0",
    "remotion": "4.0.536",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "4.6.7",
    "@myeve/capability-enforcement": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.x",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "axe-core": "4.14.0",
    "just-bash": "^3.6.0",
    "microsandbox": "^0.7.8",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
