{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "../../*"
      ]
    },
    "types": [
      "node",
      "react",
      "next"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "./*.ts",
    "../../agent/tools/installed_apps.ts",
    "../../app/api/myapps/**/*.ts",
    "../../app/apps/installed/*.tsx"
  ]
}
